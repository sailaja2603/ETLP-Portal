# ===================================================
# ETLP Backend Production Environment Variables Example
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://etlp-portal.vercel.app

# MySQL Database Configuration
DB_HOST=your-cloud-mysql-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your_secure_db_password
DB_NAME=etlp

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars

# Cloudinary Storage Credentials (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer / SMTP Email Credentials (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Google Drive Integration Credentials (Optional)
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key
